{application, bosun_core, [
    {description, "Bosun domain layer: projects, tasks, status workflow, feedback, search, BQL"},
    {vsn, "0.1.0"},
    {registered, [bosun_core_sup, bosun_search]},
    {mod, {bosun_core_app, []}},
    %% mnesia 不在这里：由 bosun_store:init/0 设好目录后再启动（release 里 {mnesia, load}）
    {applications, [kernel, stdlib, crypto, bitcask, gen_smtp]},
    {env, [{data_dir, "data"}, {smtp, []}]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
