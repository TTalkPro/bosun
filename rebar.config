{minimum_otp_vsn, "27"}.

{erl_opts, [
    debug_info,
    warnings,
    warn_unused_vars,
    warn_export_all,
    warn_shadow_vars,
    warn_obsolete_guard,
    warn_unused_import,
    warn_unused_function,
    warn_bif_clash,
    warn_export_vars,
    warn_untyped_record
]}.

%% docs/AGENT-WORKFLOW*.md 是工作流规则的唯一来源；编译时拷进 bosun_core/priv/workflow
%% （gitignore），运行时由 bosun_workflow 读取，MCP 资源与 REST 都返回它。
{pre_hooks, [
    {compile, "sh scripts/sync-docs.sh"}
]}.

{project_app_dirs, [
    "apps/bosun_core",
    "apps/bosun_mcp",
    "apps/bosun_web"
]}.

{deps, [
    %% 本地开发用 _checkouts/ 覆盖（软链到 ~/workspace/beamai、~/workspace/beamai_extra、~/workspace/bitcask）
    {beamai_core, {git_subdir, "https://github.com/TTalkPro/beamai.git",       {branch, "main"}, "apps/beamai_core"}},
    {beamai_mcp,  {git_subdir, "https://github.com/TTalkPro/beamai_extra.git", {branch, "main"}, "apps/beamai_mcp"}},
    %% 全文检索（BM25 + jieba 分词），C++ NIF；主数据仍在 Mnesia，bitcask 只做索引
    {bitcask, {git, "https://github.com/DavidAlphaFox/bitcask.git", {tag, "6.4.1"}}},
    {cowboy, "2.12.0"},
    {gun, "2.1.0"},
    {uuid, "2.0.6", {pkg, uuid_erl}},
    %% 注册验证码邮件（designs/13）；未配置 SMTP 时不发信，验证码打日志
    {gen_smtp, "1.3.0"}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [bosun_core, bosun_mcp, bosun_web]}
]}.

%% release：`rebar3 release`（dev，不带 ERTS，软链 lib）/ `rebar3 as prod tar`（prod，
%% 自带 ERTS、去 debug_info，产出 _build/prod/rel/bosun/bosun-<vsn>.tar.gz）。
%% mnesia 只 load 不 start：数据目录由 bosun_store 按 BOSUN_DATA_DIR / data_dir 决定后再拉起。
{relx, [
    {release, {bosun, "0.1.0"}, [
        {mnesia, load},
        bitcask,
        bosun_core,
        bosun_mcp,
        bosun_web,
        sasl
    ]},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {mode, dev},
    {extended_start_script, true},
    {overlay, [
        {mkdir, "data"},
        {copy, "scripts/export.sh", "bin/export.sh"},
        {copy, "scripts/import.sh", "bin/import.sh"},
        {copy, "config/release.env.example", "release.env.example"}
    ]}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]},
    {prod, [
        {erl_opts, [no_debug_info]},
        {relx, [
            {mode, prod},
            {include_src, false},
            {sys_config, "config/sys.config"},
            {vm_args, "config/prod.vm.args"}
        ]}
    ]}
]}.

{dialyzer, [
    {plt_extra_apps, [cowboy, cowlib, ranch, mnesia]}
]}.

{alias, [
    {check, [xref, dialyzer, eunit, ct]}
]}.

{xref_checks, [undefined_function_calls, undefined_functions, locals_not_used,
               deprecated_function_calls, deprecated_functions]}.
