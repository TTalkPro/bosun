#!/bin/sh
#
# Bosun task manager (REST + MCP) —— FreeBSD rc.d 脚本，用 daemon(8) 托管 release。
#
# 安装：
#   pw useradd bosun -d /var/db/bosun -s /usr/sbin/nologin -c "Bosun"
#   mkdir -p /usr/local/bosun /var/db/bosun && tar xzf bosun-0.1.0.tar.gz -C /usr/local/bosun
#   chown -R bosun:bosun /usr/local/bosun /var/db/bosun
#   install -m 555 deploy/freebsd/bosun /usr/local/etc/rc.d/bosun
#   sysrc bosun_enable=YES            # 其余变量按需 sysrc bosun_http_port=4000 ...
#   service bosun start
#   tail -f /var/log/bosun/bosun.log
#
# rc.conf 变量（括号内为缺省值）：
#   bosun_enable      (NO)                启用
#   bosun_user        (bosun)             运行用户
#   bosun_root        (/usr/local/bosun)  release 解压目录（含 bin/bosun）
#   bosun_data_dir    (/var/db/bosun)     数据目录 → BOSUN_DATA_DIR（mnesia/ 与 search/ 都在下面）
#   bosun_http_ip     (127.0.0.1)         → BOSUN_HTTP_IP
#   bosun_http_port   (4000)              → BOSUN_HTTP_PORT
#   bosun_log         (/var/log/bosun/bosun.log)  stdout/stderr 落这里；设为 "syslog" 则改走 syslog
#   bosun_env         ()                  额外环境变量，如 "FOO=1 BAR=2"
#
# 依赖：release 需在同一 OS/架构上用 `rebar3 as prod tar` 构建（自带 ERTS，不跨平台）。

# PROVIDE: bosun
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name="bosun"
rcvar="bosun_enable"

load_rc_config $name

: ${bosun_enable:="NO"}
: ${bosun_user:="bosun"}
: ${bosun_root:="/usr/local/bosun"}
: ${bosun_data_dir:="/var/db/bosun"}
: ${bosun_http_ip:="127.0.0.1"}
: ${bosun_http_port:="4000"}
: ${bosun_log:="/var/log/bosun/bosun.log"}
: ${bosun_env:=""}

pidfile="/var/run/${name}/${name}.pid"
command="/usr/sbin/daemon"
procname="${bosun_root}/erts-*/bin/beam.smp"

start_precmd="bosun_prestart"
start_cmd="bosun_start"
# stop 走 rc.subr 缺省：按 pidfile 发 SIGTERM，Erlang 收到后 init:stop 优雅关闭（mnesia / bitcask 正常 close）
sig_stop="TERM"

bosun_prestart()
{
	install -d -o "${bosun_user}" -g "${bosun_user}" -m 755 "/var/run/${name}" || return 1
	install -d -o "${bosun_user}" -g "${bosun_user}" -m 755 "${bosun_data_dir}" || return 1
	if [ "${bosun_log}" != "syslog" ]; then
		install -d -o "${bosun_user}" -g "${bosun_user}" -m 755 "$(dirname "${bosun_log}")" || return 1
	fi
	if [ ! -x "${bosun_root}/bin/bosun" ]; then
		err 1 "${bosun_root}/bin/bosun not found; extract the release tarball there"
	fi
	return 0
}

bosun_start()
{
	echo "Starting ${name}."
	local out
	if [ "${bosun_log}" = "syslog" ]; then
		out="-S -T ${name}"
	else
		out="-o ${bosun_log}"
	fi
	# HOME 指向数据目录：Erlang 要在 HOME 下写 .erlang.cookie
	# daemon -f 后台化并写 pidfile；-P 记 daemon 自身 pid 便于 stop（-p 记子进程）
	/usr/bin/env -i \
		PATH="/usr/local/bin:/usr/bin:/bin" \
		HOME="${bosun_data_dir}" \
		LANG="C.UTF-8" \
		RELEASE_ROOT_DIR="${bosun_root}" \
		BOSUN_DATA_DIR="${bosun_data_dir}" \
		BOSUN_HTTP_IP="${bosun_http_ip}" \
		BOSUN_HTTP_PORT="${bosun_http_port}" \
		${bosun_env} \
		${command} -f -p "${pidfile}" -u "${bosun_user}" -t "${name}" ${out} \
			"${bosun_root}/bin/bosun" foreground
}

run_rc_command "$1"
