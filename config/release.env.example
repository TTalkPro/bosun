# Bosun release 环境变量（复制成 release.env 后 `source` 再启动，或直接 export）
# 未设置时用 releases/<vsn>/sys.config 里的缺省值。
#
# 监听地址 / 端口
export BOSUN_HTTP_IP=127.0.0.1
export BOSUN_HTTP_PORT=4000
# 数据目录（相对路径相对于 release 根目录）：mnesia 与搜索索引都放在下面
export BOSUN_DATA_DIR=data
# 注册验证码邮件：设了 RELAY 才发信，否则验证码打在日志里（bosun_mailer [log mode]）
#export BOSUN_SMTP_RELAY=smtp.example.com
#export BOSUN_SMTP_PORT=587
#export BOSUN_SMTP_USERNAME=bosun@example.com
#export BOSUN_SMTP_PASSWORD=secret
#export BOSUN_SMTP_FROM=bosun@example.com
# https 部署：登录 Cookie 加 Secure
#export BOSUN_COOKIE_SECURE=true
