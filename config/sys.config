%% 环境变量优先于这里的值：BOSUN_HTTP_IP / BOSUN_HTTP_PORT / BOSUN_DATA_DIR / BOSUN_SMTP_* / BOSUN_COOKIE_SECURE
[
 {bosun_web, [
     {ip, {127,0,0,1}},
     {port, 4000},
     {static_dir, priv},               %% priv = apps/bosun_web/priv/static（pnpm build 输出）；也可给绝对路径
     {cookie_secure, false}            %% https 部署改 true（登录 Cookie 加 Secure）
 ]},
 {bosun_core, [
     {data_dir, "data"},               %% mnesia 在 data/mnesia，bitcask 索引在 data/search（可删，自动重建）
     %% 注册验证码邮件（gen_smtp）。[] = 日志模式，验证码打到 logger；
     %% 例：[{relay, "smtp.example.com"}, {port, 587}, {username, "u"}, {password, "p"}, {from, "bosun@example.com"}]
     {smtp, []}
 ]}
].
