%% 环境变量优先于这里的值：BOSUN_HTTP_IP / BOSUN_HTTP_PORT / BOSUN_DATA_DIR / BOSUN_SMTP_* / BOSUN_COOKIE_SECURE / BOSUN_TRUST_PROXY
[
 {bosun_web, [
     {ip, {127,0,0,1}},
     {port, 5000},
     {static_dir, priv},               %% priv = apps/bosun_web/priv/static（pnpm build 输出）；也可给绝对路径
     {cookie_secure, false},           %% https 部署改 true（登录 Cookie 加 Secure）
     %% 前面有反向代理（nginx / caddy）时改 true：登录 / 发码的限流按 X-Forwarded-For 最右一项算来源 IP，
     %% 否则所有人共用代理那一个 IP 的额度。没有代理别开（等于让客户端自报 IP）。
     {trust_proxy, false}
 ]},
 {bosun_core, [
     {data_dir, "data"},               %% mnesia 在 data/mnesia，bitcask 索引在 data/search（可删，自动重建）
     %% 检索索引定时回收死数据：多久看一次（毫秒，off = 不定时）、死字节到多少才动手
     %% {search_merge_interval, 21600000}, {search_merge_min_dead_bytes, 1048576},
     %% 注册验证码邮件（gen_smtp）。[] = 日志模式，验证码打到 logger；
     %% 例：[{relay, "smtp.example.com"}, {port, 587}, {username, "u"}, {password, "p"}, {from, "bosun@example.com"}]
     {smtp, []}
 ]}
].
