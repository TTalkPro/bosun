{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": { "@mui/material": ["./src/mui-compat/material.tsx"], "@mui/material/styles": ["./src/mui-compat/material.tsx"], "@mui/lab": ["./src/mui-compat/lab.tsx"], "@mui/icons-material/*": ["./src/mui-compat/icons.ts"], "@mui/x-data-grid": ["./src/mui-compat/material.tsx"], "@/*": ["src/*"] }
  },
  "include": ["src"]
}
